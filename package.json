{
  "name": "benefit-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "api:gen": "node scripts/gen-api.mjs",
    "api:check": "node scripts/check-api.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts --project=chromium",
    "e2e:all": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
