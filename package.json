    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "shadcn": "4.23.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
