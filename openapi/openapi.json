            "$ref": "#/components/schemas/UserPublic"
          }
        },
        "required": [
          "user",
          "expires_at"
        ],
        "title": "SessionInfo",
        "type": "object"
      },
      "UserPublic": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "household_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Household Id"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
