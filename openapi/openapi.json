{
  "components": {
    "schemas": {
      "ActionType": {
        "enum": [
          "approve_denial",
          "override_to_approve",
          "request_information",
          "correct_value",
          "dismiss_finding",
          "accept_findings",
          "approve",
          "edit_and_approve",
          "deny_missing_information",
          "extend_15_days",
          "continue_with_held_data"
        ],
        "title": "ActionType",
        "type": "string"
      },
      "ApplicantMember": {
        "additionalProperties": false,
        "properties": {
          "citizenship_status": {
            "$ref": "#/components/schemas/CitizenshipStatus"
          },
          "date_of_birth": {
            "format": "date",
            "title": "Date Of Birth",
            "type": "string"
          },
          "full_name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/Job"
            },
            "maxItems": 5,
            "title": "Jobs",
            "type": "array"
          },
          "medicare_entitled": {
            "title": "Medicare Entitled",
            "type": "boolean"
          },
          "relationship": {
            "$ref": "#/components/schemas/Relationship"
          },
          "zero_income": {
            "title": "Zero Income",
            "type": "boolean"
          }
        },
        "required": [
          "full_name",
          "date_of_birth",
          "relationship",
          "citizenship_status",
          "medicare_entitled",
          "zero_income"
        ],
        "title": "ApplicantMember",
        "type": "object"
      },
      "ApplicationForm": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "$ref": "#/components/schemas/IllinoisAddress"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/ApplicantMember"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Members",
            "type": "array"
          }
        },
        "required": [
          "members",
          "address"
        ],
        "title": "ApplicationForm",
        "type": "object"
      },
      "ApplicationSubmission": {
        "additionalProperties": false,
        "description": "API body; the household comes from the session, never from the body.",
        "properties": {
          "form": {
            "$ref": "#/components/schemas/ApplicationForm"
          },
          "submission_reference": {
            "format": "uuid",
            "title": "Submission Reference",
            "type": "string"
          }
        },
        "required": [
          "submission_reference",
          "form"
        ],
        "title": "ApplicationSubmission",
        "type": "object"
      },
      "CaseDetail": {
        "additionalProperties": false,
        "properties": {
          "at_risk": {
            "default": false,
            "title": "At Risk",
            "type": "boolean"
          },
          "case_id": {
            "format": "uuid",
            "title": "Case Id",
            "type": "string"
          },
          "case_type": {
            "$ref": "#/components/schemas/CaseType"
          },
          "coverage_period": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CoverageSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "days_remaining": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "null once decided",
            "title": "Days Remaining"
          },
          "decision_deadline": {
            "format": "date",
            "title": "Decision Deadline",
            "type": "string"
          },
          "demo_clock": {
            "default": false,
            "title": "Demo Clock",
            "type": "boolean"
          },
          "denial_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DenialReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "open_review_task": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OpenReviewTask"
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CaseOutcome"
              },
              {
                "type": "null"
              }
            ]
          },
          "override": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OverrideSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "received_on": {
            "format": "date",
            "title": "Received On",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/CaseState"
          }
        },
        "required": [
          "case_id",
          "state",
          "received_on",
          "decision_deadline",
          "days_remaining",
          "at_risk",
          "outcome",
          "denial_reason",
          "open_review_task",
          "case_type",
          "coverage_period",
          "override",
          "demo_clock"
        ],
        "title": "CaseDetail",
        "type": "object"
      },
      "CaseEventKind": {
        "enum": [
          "state_changed",
          "review_task_opened",
          "caseworker_action",
          "action_rejected",
          "notice_requested",
          "coverage_started",
          "demo_action"
        ],
        "title": "CaseEventKind",
        "type": "string"
      },
      "CaseHistoryEntry": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "description": "System or a display name",
            "title": "Actor",
            "type": "string"
          },
          "actor_type": {
            "$ref": "#/components/schemas/EventActorType"
          },
          "case_time": {
            "format": "date-time",
            "title": "Case Time",
            "type": "string"
          },
          "from_state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CaseState"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/CaseEventKind"
          },
          "real_time": {
            "format": "date-time",
            "title": "Real Time",
            "type": "string"
          },
          "reason_code": {
            "title": "Reason Code",
            "type": "string"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "to_state": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CaseState"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "seq",
          "kind",
          "case_time",
          "real_time",
          "actor",
          "actor_type",
          "reason_code"
        ],
        "title": "CaseHistoryEntry",
        "type": "object"
      },
      "CaseHistoryPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CaseHistoryEntry"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "CaseHistoryPage",
        "type": "object"
      },
      "CaseOutcome": {
        "enum": [
          "approved",
          "denied",
          "renewed_automatically",
          "renewed_after_response",
          "ended_by_caseworker"
        ],
        "title": "CaseOutcome",
        "type": "string"
      },
      "CasePage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/CaseSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "CasePage",
        "type": "object"
      },
      "CaseState": {
        "enum": [
          "submitted",
          "verifying",
          "awaiting_applicant",
          "determining",
          "under_review",
          "decided"
        ],
        "title": "CaseState",
        "type": "string"
      },
      "CaseStatus": {
        "additionalProperties": false,
        "description": "Query result `status` and API response. `at_risk` is derived from `days_remaining`.",
        "properties": {
          "at_risk": {
            "default": false,
            "title": "At Risk",
            "type": "boolean"
          },
          "case_id": {
            "format": "uuid",
            "title": "Case Id",
            "type": "string"
          },
          "days_remaining": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "null once decided",
            "title": "Days Remaining"
          },
          "decision_deadline": {
            "format": "date",
            "title": "Decision Deadline",
            "type": "string"
          },
          "denial_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DenialReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "open_review_task": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OpenReviewTask"
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CaseOutcome"
              },
              {
                "type": "null"
              }
            ]
          },
          "received_on": {
            "format": "date",
            "title": "Received On",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/CaseState"
          }
        },
        "required": [
          "case_id",
          "state",
          "received_on",
          "decision_deadline",
          "days_remaining",
          "at_risk",
          "outcome",
          "denial_reason",
          "open_review_task"
        ],
        "title": "CaseStatus",
        "type": "object"
      },
      "CaseSummary": {
        "additionalProperties": false,
        "properties": {
          "at_risk": {
            "default": false,
            "title": "At Risk",
            "type": "boolean"
          },
          "case_id": {
            "format": "uuid",
            "title": "Case Id",
            "type": "string"
          },
          "case_type": {
            "$ref": "#/components/schemas/CaseType"
          },
          "days_remaining": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Days Remaining"
          },
          "decision_deadline": {
            "format": "date",
            "title": "Decision Deadline",
            "type": "string"
          },
          "outcome": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CaseOutcome"
              },
              {
                "type": "null"
              }
            ]
          },
          "received_on": {
            "format": "date",
            "title": "Received On",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/CaseState"
          }
        },
        "required": [
          "case_id",
          "case_type",
          "state",
          "received_on",
          "decision_deadline"
        ],
        "title": "CaseSummary",
        "type": "object"
      },
      "CaseType": {
        "enum": [
          "application",
          "redetermination"
        ],
        "title": "CaseType",
        "type": "string"
      },
      "CheckStatus": {
        "enum": [
          "ok",
          "down",
          "degraded"
        ],
        "title": "CheckStatus",
        "type": "string"
      },
      "CitizenshipStatus": {
        "enum": [
          "us_citizen",
          "qualifying_immigrant",
          "neither"
        ],
        "title": "CitizenshipStatus",
        "type": "string"
      },
      "CoverageStatus": {
        "enum": [
          "active",
          "continued_pending_review",
          "renewed",
          "ended"
        ],
        "title": "CoverageStatus",
        "type": "string"
      },
      "CoverageSummary": {
        "additionalProperties": false,
        "properties": {
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CoverageStatus"
          }
        },
        "required": [
          "start_date",
          "end_date",
          "status"
        ],
        "title": "CoverageSummary",
        "type": "object"
      },
      "DenialReason": {
        "enum": [
          "income_over_limit",
          "other_rule_not_met",
          "missing_information"
        ],
        "title": "DenialReason",
        "type": "string"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Fields",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "reference_id": {
            "title": "Reference Id",
            "type": "string"
          },
          "related_case_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Related Case Id"
          }
        },
        "required": [
          "code",
          "message",
          "fields",
          "reference_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "auth.required",
          "auth.session_expired",
          "auth.invalid_credentials",
          "auth.forbidden",
          "not_found",
          "conflict",
          "validation_failed",
          "internal_error",
          "dependency_unavailable"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "EventActorType": {
        "enum": [
          "system",
          "user"
        ],
        "title": "EventActorType",
        "type": "string"
      },
      "FieldError": {
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message",
          "type"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthReport": {
        "properties": {
          "component": {
            "title": "Component",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "synthetic_data": {
            "const": true,
            "default": true,
            "title": "Synthetic Data",
            "type": "boolean"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "component",
          "version"
        ],
        "title": "HealthReport",
        "type": "object"
      },
      "IllinoisAddress": {
        "additionalProperties": false,
        "properties": {
          "city": {
            "maxLength": 60,
            "minLength": 1,
            "title": "City",
            "type": "string"
          },
          "line1": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Line1",
            "type": "string"
          },
          "line2": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line2"
          },
          "postal_code": {
            "pattern": "^\\d{5}$",
            "title": "Postal Code",
            "type": "string"
          },
          "state": {
            "const": "IL",
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "line1",
          "city",
          "state",
          "postal_code"
        ],
        "title": "IllinoisAddress",
        "type": "object"
      },
      "Job": {
        "additionalProperties": false,
        "properties": {
          "declared_monthly_gross": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Declared Monthly Gross"
          },
          "employer": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Employer",
            "type": "string"
          },
          "pay_frequency": {
            "$ref": "#/components/schemas/PayFrequency"
          }
        },
        "required": [
          "employer",
          "pay_frequency",
          "declared_monthly_gross"
        ],
        "title": "Job",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "OpenReviewTask": {
        "additionalProperties": false,
        "properties": {
          "allowed_actions": {
            "items": {
              "$ref": "#/components/schemas/ActionType"
            },
            "title": "Allowed Actions",
            "type": "array"
          },
          "reason": {
            "$ref": "#/components/schemas/ReviewReason"
          },
          "task_id": {
            "format": "uuid",
            "title": "Task Id",
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "reason",
          "allowed_actions"
        ],
        "title": "OpenReviewTask",
        "type": "object"
      },
      "OverrideSummary": {
        "additionalProperties": false,
        "properties": {
          "decided_on": {
            "format": "date",
            "title": "Decided On",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "null for applicants",
            "title": "Reason"
          },
          "reviewer_name": {
            "title": "Reviewer Name",
            "type": "string"
          }
        },
        "required": [
          "reviewer_name",
          "decided_on"
        ],
        "title": "OverrideSummary",
        "type": "object"
      },
      "PayFrequency": {
        "enum": [
          "weekly",
          "biweekly",
          "semimonthly",
          "monthly"
        ],
        "title": "PayFrequency",
        "type": "string"
      },
      "ReadinessCheck": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "required": {
            "title": "Required",
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          }
        },
        "required": [
          "name",
          "status",
          "required"
        ],
        "title": "ReadinessCheck",
        "type": "object"
      },
      "ReadinessReport": {
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "component": {
            "title": "Component",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ReadinessStatus"
          }
        },
        "required": [
          "component",
          "status",
          "checks"
        ],
        "title": "ReadinessReport",
        "type": "object"
      },
      "ReadinessStatus": {
        "enum": [
          "ready",
          "degraded",
          "not_ready"
        ],
        "title": "ReadinessStatus",
        "type": "string"
      },
      "Relationship": {
        "enum": [
          "self",
          "spouse",
          "partner",
          "child",
          "parent",
          "sibling",
          "other_relative",
          "other"
        ],
        "title": "Relationship",
        "type": "string"
      },
      "ReviewActionBody": {
        "additionalProperties": false,
        "description": "A caseworker's action. The reviewer comes from the session, never from the body.\n\n`reason` is never logged or echoed in an error (PL-11).",
        "properties": {
          "action": {
            "enum": [
              "approve_denial",
              "override_to_approve"
            ],
            "title": "Action",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "action",
          "request_id"
        ],
        "title": "ReviewActionBody",
        "type": "object"
      },
      "ReviewReason": {
        "enum": [
          "adverse_determination",
          "cannot_determine",
          "notice_approval",
          "verification_review",
          "missed_response_deadline",
          "explanation_review"
        ],
        "title": "ReviewReason",
        "type": "string"
      },
      "Role": {
        "enum": [
          "applicant",
          "caseworker",
          "supervisor"
        ],
        "title": "Role",
        "type": "string"
      },
      "SessionInfo": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
